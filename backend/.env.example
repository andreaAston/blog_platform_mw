# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (your React app)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (Supabase Postgres) ----
# Supabase dashboard -> Connect -> "Session pooler" string (works on IPv4 networks).
# Format: postgres://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blog_dev
# true for Supabase, false for a local Postgres
DATABASE_SSL=false
# Optional separate database for `npm test`
# TEST_DATABASE_URL=

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# Failed logins allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# ---- Cover image uploads (optional) ----
# If these are empty, images are saved to ./uploads (fine for local dev only).
# On Render the disk is wiped on redeploy, so use Supabase Storage in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=covers
